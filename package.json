{
  "name": "qkkdecrypt",
  "version": "1.4.3",
  "private": true,
  "description": "QKKDecrypt packaging and release entry",
  "scripts": {
    "start:electron": "npm run build:electron && electron desktop/dist/main.cjs",
    "build:electron": "node .\\scripts\\build-electron.js",
    "typecheck:electron": "tsc --noEmit -p desktop/tsconfig.json",
    "test:electron": "npm run build:electron && npm run typecheck:electron && node --import tsx --test desktop/tests/*.test.ts",
    "package": "node .\\script\\package.js",
    "package:electron": "node .\\scripts\\package-electron.js",
    "build:console": "node .\\script\\build-console.js",
    "build:ui": "node .\\script\\build-ui.js",
    "build:native": "powershell -ExecutionPolicy Bypass -File .\\native\\build_native.ps1",
    "release": "semantic-release"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.4",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "electron": "^37.0.0",
    "esbuild": "^0.25.5",
    "semantic-release": "^24.2.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
